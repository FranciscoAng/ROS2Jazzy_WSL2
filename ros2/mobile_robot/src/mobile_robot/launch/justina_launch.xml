<?xml version="1.0"?>

<launch>

  <arg name="urdf_path" default="$(find-pkg-share mobile_robot)/models/robot_urdf.xacro"/>
  <arg name="gazebo_config_path" default="$(find-pkg-share mobile_robot)/config/gazebo_bridge.yaml"/>
  <arg name="gazebo_world_path" default="$(find-pkg-share mobile_robot)/worlds/world1.sdf"/>

  <arg name="start_gazebo" default="true"/>
  <arg name="start_rviz" default="true"/>

  <let name="gazebo_launch" value="$(find-pkg-share ros_gz_sim)/launch/gz_sim.launch.py"/>

  <node pkg="robot_state_publisher" exec="robot_state_publisher">
    <param name="robot_description" value="$(command 'xacro $(var urdf_path)')"/>
    <param name="use_sim_time" value="true" />
  </node>
  
  <!-- 
  <node pkg="joint_state_publisher_gui" exec="joint_state_publisher_gui" name="joint_state_publisher_gui" output="screen"/>
  -->
  
  <group if="$(var start_gazebo)">
    <include file="$(var gazebo_launch)">
      <arg name="gz_args" value="-r $(var gazebo_world_path)"/>
    </include>

    <node pkg="ros_gz_sim" exec="create" name="spawn_robot_urdf"
      args="-topic robot_description -name my_robot" output="screen"/>
    <!-- 
    <node pkg="ros_gz_bridge" exec="parameter_bridge" name="ros_gz_bridge" output="screen" args="/cmd_vel@geometry_msgs/msg/Twist@gz.msgs.Twist /odom@nav_msgs/msg/Odometry@gz.msgs.Odometry /clock@rosgraph_msgs/msg/Clock[gz.msgs.Clock"/>
    -->
    <node pkg="ros_gz_bridge" exec="parameter_bridge">
      <param name="config_file" value="$(var gazebo_config_path)"/>
    </node>

  </group>

  <node pkg="rviz2" exec="rviz2" output="screen"/>
</launch>