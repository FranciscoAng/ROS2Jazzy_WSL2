<?xml version="1.0"?>
<!-- ######################################## -->
<!-- URDF for Differential Robot -->
<!-- ######################################## -->
<robot name="diff_drive_bot" xmlns:xacro="http://www.ros.org/wiki/xacro">

<!-- ######################################## -->
<!-- Geometry and Constraints-->
<!-- ######################################## -->
<!-- Pi Constraint-->
<xacro:property name="pi_const" value="3.14159265"/>

<!-- Body dimensions -->
<xacro:property name="a" value="1.0"/>
<xacro:property name="b" value="1.0"/>
<xacro:property name="c" value="1.0"/>

<!-- Wheel and caster dimensions-->
<!-- Wheel and caster radius-->
<xacro:property name="r" value="0.15"/>
<!-- Wheel width-->
<xacro:property name="d" value="0.1"/>

<xacro:property name="s1" value="${b/2+r}"/>
<xacro:property name="s2" value="${2*r}"/>
<xacro:property name="s3" value="${2*r}"/>
<xacro:property name="s4" value="${c/2+d/2}"/>

<!-- ######################################## -->
<!-- Mass and inertia -->
<!-- ######################################## -->

<!-- Material density -->

  <!-- Base Link (Robot Chassis Center) -->
  <link name="base_link">
    <visual>
      <geometry>
        <box size="0.4 0.3 0.15"/>
      </geometry>
      <material name="chassis_color">
        <color rgba="0.2 0.4 0.8 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="0.4 0.3 0.15"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="5.0"/>
      <inertia ixx="0.0468" ixy="0.0" ixz="0.0" iyy="0.0729" iyz="0.0" izz="0.1041"/>
    </inertial>
  </link>

  <!-- Left Wheel Link -->
  <link name="left_wheel">
    <visual>
      <geometry>
        <cylinder length="0.04" radius="0.08"/>
      </geometry>
      <material name="wheel_color">
        <color rgba="0.1 0.1 0.1 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.04" radius="0.08"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.00086" ixy="0.0" ixz="0.0" iyy="0.00086" iyz="0.0" izz="0.0016"/>
    </inertial>
  </link>

  <!-- Left Wheel Joint -->
  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel"/>
    <origin xyz="0.0 0.175 -0.05" rpy="-1.5708 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <!-- Right Wheel Link -->
  <link name="right_wheel">
    <visual>
      <geometry>
        <cylinder length="0.04" radius="0.08"/>
      </geometry>
      <material name="wheel_color"/>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.04" radius="0.08"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.00086" ixy="0.0" ixz="0.0" iyy="0.00086" iyz="0.0" izz="0.0016"/>
    </inertial>
  </link>

  <!-- Right Wheel Joint -->
  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel"/>
    <origin xyz="0.0 -0.175 -0.05" rpy="-1.5708 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <!-- Rear Caster Wheel Link -->
  <link name="caster_wheel">
    <visual>
      <geometry>
        <sphere radius="0.04"/>
      </geometry>
      <material name="caster_color">
        <color rgba="0.6 0.6 0.6 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <sphere radius="0.04"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.2"/>
      <inertia ixx="0.000128" ixy="0.0" ixz="0.0" iyy="0.000128" iyz="0.0" izz="0.000128"/>
    </inertial>
  </link>

  <!-- Rear Caster Wheel Joint -->
  <joint name="caster_wheel_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_wheel"/>
    <origin xyz="-0.15 0.0 -0.09" rpy="0 0 0"/>
  </joint>

</robot>